# deps / build output
node_modules/
dist/
.vercel/

# test + tool artifacts
test-results/
e2e/__artifacts__/
playwright-report/
.playwright-cli/
.deepeval/

# gameplay captures (not part of the build); also covers concepts/ Seedance clips
*.mp4
# ...except the README demo, which is a deliberate deliverable (scripts/record-demo.mjs).
!docs/media/demo.mp4

# concepts/ is art AUTHORING, not shipped. Keep the provenance trail
# (*.prompt.txt, *.job.json, README.md); drop the raw pixels/video.
concepts/**/*.png
concepts/**/*.gif
# Phase 20 audio masters: ~15 MB of raw model output, re-generatable at credit cost.
# The .prompt.txt and .job.json records ARE committed, same policy as the image masters.
concepts/**/*.wav
concepts/**/*.mp3
concepts/**/*.flac

.vercel

# secrets. No .env exists today and none was ever committed — this is here so one can never be
# committed by ACCIDENT, which matters precisely because a push to main is a production deploy.
.env
.env.*
!.env.example

e2e/.registry-lock/

# Python bytecode — build junk; scripts chain by importlib so these appear on any run.
__pycache__/
*.pyc
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
.gitignore
